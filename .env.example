# ─── App ────────────────────────────────────────────────────────────────────
# In production: https://vidisprint.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Database (Supabase Postgres) ───────────────────────────────────────────
# Pooled connection (pgbouncer) for the app, direct connection for migrations
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vidisprint?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/vidisprint?schema=public"

# ─── Auth (NextAuth.js v5) ──────────────────────────────────────────────────
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── AI (Anthropic Claude) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ─── Text-to-Speech (ElevenLabs) ────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ─── Stock footage (Pexels — free API key at pexels.com/api) ────────────────
PEXELS_API_KEY=

# ─── Second stock catalog, optional (Pixabay — free API key at pixabay.com/api/docs) ─
# Fills gaps Pexels leaves empty on specific, narrow subjects. Everything works
# with Pexels alone; this only ever adds results, never required.
PIXABAY_API_KEY=

# ─── Storage (S3-compatible: Supabase Storage / Cloudflare R2 / AWS S3) ─────
# Leave STORAGE_DRIVER=local for development (files are written to ./storage and served via /api/files)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=storage
S3_ENDPOINT=
S3_REGION=us-east-1
# Former app name, kept on purpose: it names the existing bucket.
S3_BUCKET=clipforge
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ─── Rendering ──────────────────────────────────────────────────────────────
# local  → the Node worker (npm run worker) renders with @remotion/renderer on this machine
# lambda → Remotion Lambda (set the three vars below)
RENDER_ENGINE=local
REMOTION_AWS_REGION=us-east-1
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_SERVE_URL=
# Optional: reuse an installed Chromium for local renders instead of downloading Chrome Headless Shell
REMOTION_BROWSER_EXECUTABLE=
# Shared secret so only trusted schedulers can hit /api/jobs/process
CRON_SECRET="generate-with-openssl-rand-hex-32"

# ─── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_YEARLY=
STRIPE_PRICE_CREDITS_100=
STRIPE_PRICE_CREDITS_500=
STRIPE_PRICE_CREDITS_2000=

# ─── Social publishing OAuth apps ───────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# 32-byte hex key used to encrypt social OAuth tokens at rest
TOKEN_ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"
